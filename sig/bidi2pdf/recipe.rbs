module Bidi2pdf
  # A recipe is a rendering contract: the waits and preparation a page needs before it is printed,
  # and the properties the resulting PDF must have - not a general browser-automation script.
  # `bidi2pdf run recipe.yml` is Loader -> (an invalid recipe stops here, no browser ever
  # launches) -> Validator -> Runner.
  class Recipe
    @data: untyped

    @path: untyped

    KNOWN_TOP_LEVEL_KEYS: ::Array["version" | "source" | "browser" | "headers" | "cookies" | "auth" | "actions" | "assert" | "print" | "output"]

    KNOWN_ACTIONS: ::Array["wait_for" | "click" | "evaluate" | "inject_script" | "inject_style" | "set_viewport" | "wait_network_idle"]

    PAGE_ASSERTIONS: ::Array["selector_exists" | "text_present" | "no_console_errors" | "no_network_failures" | "fonts_loaded"]

    PDF_ASSERTIONS: ::Array["page_count" | "pdf_text_present" | "pdf_not_blank"]

    KNOWN_ASSERTIONS: untyped

    KNOWN_OUTPUTS: ::Array["pdf" | "manifest" | "screenshot"]

    attr_reader data: untyped

    attr_reader path: untyped

    def self.load: (untyped path) -> untyped

    def initialize: (untyped data, ?path: untyped?) -> void

    def validate!: () -> untyped

    def actions: () -> untyped

    def assertions: () -> untyped

    def source: () -> untyped

    def browser_options: () -> untyped

    def headers: () -> untyped

    def cookies: () -> untyped

    def auth: () -> untyped

    def print_options: () -> untyped

    def output: () -> untyped

    def needs_pdf?: () -> untyped

    def self.step_name: (untyped step) -> untyped

    def step_name: (untyped step) -> untyped

    # The value beside a step's name - a Hash of options (`wait_for: {selector: ..., timeout:
    # ...}`), a bare scalar (`page_count: 2`, `no_console_errors: true`), or nil.
    def step_value: (untyped step) -> (untyped | nil)

    # step_value coerced to a Hash of options - most actions/assertions take this shape; a bare
    # scalar step (page_count: 2, no_console_errors: true) has no options of its own to offer here,
    # so callers that need the scalar itself use #step_value directly.
    def step_options: (untyped step) -> untyped
  end
end
