module Bidi2pdf
  module Bidi
    class NetworkEvents
      @context_id: untyped

      @events: untyped

      @network_event_formatter: untyped

      attr_reader context_id: untyped

      attr_reader events: untyped

      attr_reader network_event_formatter: untyped

      def initialize: (untyped context_id) -> void

      def handle_event: (untyped data) -> untyped

      # rubocop:disable Metrics/AbcSize, Metrics/CyclomaticComplexity, Metrics/PerceivedComplexity
      def handle_response: (untyped method, untyped event) -> (nil | untyped)

      def all_events: () -> untyped

      def log_network_traffic: (?format: ::Symbol) -> untyped

      # Waits until no request is in flight, or until +timeout+ seconds passed.
      #
      # @return [Symbol] :idle when every request completed, :timeout when some were still open -
      #   it never raises for a timeout, so a caller decides whether a busy page is good enough.
      def wait_until_network_idle: (?timeout: ::Integer, ?poll_interval: ::Float) -> (:idle | :timeout | untyped)

      # Names the requests still open when the wait gives up - it carries on, it does not raise.
      def log_idle_timeout: () -> untyped
    end
  end
end
