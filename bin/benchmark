#!/usr/bin/env ruby
# frozen_string_literal: true

# Times each phase of one full render, the same shape bidi2pdf-rails drives per request: a fresh
# session, user context, window, tab, render, wait, print, teardown.
#
#   bin/benchmark [runs] [session_url] [paragraphs]
#
# session_url defaults to BIDI2PDF_SESSION_URL or http://remote-chrome:3000/session. paragraphs
# scales the document (and therefore the PDF payload that comes back over the WebSocket).

require "bundler/setup"
require "bidi2pdf"
require "base64"

runs = Integer(ARGV[0] || 5)
session_url = ARGV[1] || ENV.fetch("BIDI2PDF_SESSION_URL", "http://remote-chrome:3000/session")
paragraphs = Integer(ARGV[2] || 400)

Bidi2pdf.logger.level = Logger::WARN

LOREM = "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore."
html = "<html><body><h1>Benchmark</h1>#{Array.new(paragraphs) { |i| "<p>#{i} #{LOREM * 3}</p>" }.join}</body></html>"

def clock = Process.clock_gettime(Process::CLOCK_MONOTONIC)

def timed(totals, phase)
  started = clock
  yield
ensure
  totals[phase] << (clock - started)
end

totals = Hash.new { |hash, key| hash[key] = [] }
pdf_bytes = 0

runs.times do
  timed(totals, :total) do
    session = Bidi2pdf::Bidi::Session.new(session_url: session_url, headless: true)
    browser = timed(totals, :session_start) do
      session.start
      session.browser
    end
    context = window = tab = nil
    timed(totals, :tab_setup) do
      context = browser.create_user_context
      window = context.create_browser_window
      tab = window.create_browser_tab
    end
    timed(totals, :render) { tab.render_html_content(html) }
    timed(totals, :network_idle) { tab.wait_until_network_idle }
    timed(totals, :print) { pdf_bytes = Base64.decode64(tab.print).bytesize }
    timed(totals, :tab_teardown) do
      tab.close
      window.close
      context.close
    end
    timed(totals, :session_close) { session.close }
  end
end

puts "#{"phase".ljust(14)} #{"mean ms".rjust(9)} #{"min ms".rjust(9)} #{"max ms".rjust(9)}"
totals.each do |phase, samples|
  columns = [samples.sum / samples.size, samples.min, samples.max].map { |seconds| (seconds * 1000).round(1).to_s.rjust(9) }
  puts "#{phase.to_s.ljust(14)} #{columns.join(" ")}"
end
puts "runs=#{runs} pdf=#{pdf_bytes} bytes"
